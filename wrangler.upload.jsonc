{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resofit-upload-gateway",
  "main": "src/r2-media-worker.ts",
  "workers_dev": false,
  "keep_vars": true,
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "upload.resofit.fit/*",
      "zone_name": "resofit.fit"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "resofit-cdn"
    }
  ]
}
