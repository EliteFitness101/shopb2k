{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/martial-x",
      "destination": "https://martial.resofit.fit",
      "permanent": true
    },
    {
      "source": "/martial-x/:path*",
      "destination": "https://martial.resofit.fit/:path*",
      "permanent": true
    }
  ],
  "installCommand": "npm install --production=false"
}
