{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/martial-x",
      "destination": "https://martial.resofit.fit",
      "permanent": true
    },
    {
      "source": "/martial-x/:path*",
      "destination": "https://martial.resofit.fit/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/content/publish-cron",
      "schedule": "*/5 * * * *"
    }
  ]
}
