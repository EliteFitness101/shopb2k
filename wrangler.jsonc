{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopb2k",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    {
      "pattern": "media.resofit.fit/*",
      "zone_name": "resofit.fit"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "resofit-cdn"
    }
  ]
}
