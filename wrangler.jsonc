{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test-upload-format",
  "workers_dev": false,
  "keep_vars": true,
  "vars": {
    "R2_BUCKET_NAME": "resofit-cdn",
    "R2_ENDPOINT": "https://e8325f28fa48ca43bdfa667c062f272f.r2.cloudflarestorage.com",
    "R2_REGION": "auto"
  },
  "compatibility_date": "2025-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/r2-media-worker.ts",
  "routes": [
    {
      "pattern": "media.resofit.fit/*",
      "zone_name": "resofit.fit"
    },
    {
      "pattern": "content.resofit.fit/*",
      "zone_name": "resofit.fit"
    },
    {
      "pattern": "upload.resofit.fit/*",
      "zone_name": "resofit.fit"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "resofit-cdn"
    },
    {
      "binding": "LEGACY_MEDIA_BUCKET",
      "bucket_name": "xbang-media-canonical"
    }
  ]
}